# Base URL of a running `buildrail serve` instance. Copy this file to
# `.env` (or `.env.local`) and adjust if you changed --host/--port.
# Never put a real secret in this file — Buildrail's local service has no
# authentication and never accepts credentials from the frontend.
VITE_BUILDRAIL_API_URL=http://127.0.0.1:8787
